  "principles": [
    {
      "principle_id": "phenanthroline_mass_calibration",
      "text": "将铁还原为 Fe2+，在适宜 pH 下与邻菲啰啉形成橙红色络合物，于 510 nm 测量吸光度；用容量瓶中铁质量建立校准关系。",
      "equations": ["Fe2+ + 3 Phen -> [Fe(Phen)3]2+", "A_corr = A_raw - A_blank", "A_corr = a + b*m", "m = (A_corr-a)/b", "rho(Fe, mg/L) = (m/V)*F"],
      "assumptions": ["标准和样品的显色及测量条件一致", "样品响应位于校准响应范围内", "m 以 ug、V 以 mL 代入时 m/V 的数值等于 mg/L", "线性模型需要结合残差与实验记录判断"],
      "content_status": "source_verified",
      "evidence_refs": ["project_guide_v1", "hj_t_345_2007"]
    }
  ],
