  "objectives": [
    {"item_id": "objective_method", "text": "掌握浊点—物性结合法测定三元液液平衡数据的基本方法。", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]},
    {"item_id": "objective_diagram", "text": "测定固定温度下乙醇—环己烷—水体系的溶解度曲线和联结线，并理解三角相图。", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]},
    {"item_id": "objective_evaluation", "text": "根据两相组成计算分配系数与选择性系数，用于评价萃取分离性能。", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}
  ],
  "principles": [
    {
      "principle_id": "cloud_point",
      "text": "乙醇分别与环己烷和水具有较好的互溶性，而水在环己烷中的溶解度较小。向乙醇—环己烷均相混合物缓慢加水，体系越过双结线后出现稳定浑浊；由各组分的质量可得到该浊点组成。",
      "equations": ["w_i = m_i / Σm_i × 100%"],
      "assumptions": ["加水终点取首次出现且不立即消失的浑浊", "称量期间挥发和残留可忽略或得到控制"],
      "content_status": "source_verified",
      "evidence_refs": ["user_legacy_guide"]
    },
    {
      "principle_id": "tie_line",
      "text": "在恒温恒压下，三组分两液相平衡体系按相律只有一个自由度。静置分层后测定上、下相折射率，并通过预先建立的浓度—折射率关系确定两相组成；相图中连接一对平衡相组成的直线即联结线。",
      "equations": ["F = C - P = 1（恒温恒压，C=3，P=2）"],
      "assumptions": ["折射率标准曲线与待测样品处于相同温度", "取样不扰动相界面且两相已达到平衡"],
      "content_status": "source_verified",
      "evidence_refs": ["user_legacy_guide"]
    },
    {
      "principle_id": "distribution_selectivity",
      "text": "以乙醇为溶质、水相为萃取相 E、油相为萃余相 R。常用定义可写为乙醇分配系数 K_A=w_A^E/w_A^R，选择性系数 β=(w_A^E/w_B^E)/(w_A^R/w_B^R)=K_A/K_B。因原讲义公式为图片且未成功提取，本符号体系必须在提交前与原版讲义核对。",
      "equations": ["K_A = w_A^E / w_A^R", "K_B = w_B^E / w_B^R", "β = K_A / K_B"],
      "assumptions": ["A 为乙醇，B 为环己烷", "质量分数采用同一基准", "公式符号待对照原讲义图片确认"],
      "content_status": "needs_review",
      "evidence_refs": ["user_legacy_guide", "uestc_lle_paper", "scu_course_syllabus"]
    }
  ],
