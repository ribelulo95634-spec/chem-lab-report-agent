    {"step_id": "phase_equilibrium_01", "stage": "measurement", "action": "在浊点体系中再加入 1–2 mL 水，搅拌 1–2 min，停止后静置 15–20 min；分别取上、下相测折射率，并由标准曲线求两相组成。", "parameters": [{"name": "追加水体积", "value": "1–2", "unit": "mL", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}, {"name": "搅拌时间", "value": "1–2", "unit": "min", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}, {"name": "静置时间", "value": "15–20", "unit": "min", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}], "expected_observations": ["形成清晰的上层油相和下层水相"], "hazards": ["取样时扰动界面或交叉污染"], "stop_conditions": ["相界面不清晰", "折射仪未校准或温度不一致"], "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]},
    {"step_id": "tie_lines_01", "stage": "measurement", "action": "继续每次追加 1–2 mL 水并重复平衡、静置、分相取样和折射率测量，共获得 3–4 组数据（讲义目标为 3 条联结线）。", "parameters": [{"name": "数据组数", "value": "3–4", "unit": "组", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}], "expected_observations": ["每组均有可配对的上、下相组成"], "hazards": ["样品编号错配和相别颠倒"], "stop_conditions": ["上、下相样品无法配对", "物料或温度记录中断"], "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]},
