    {"step_id": "charge_01", "stage": "preparation", "action": "采用差量法向平衡釜加入约 5–6 mL 环己烷和约 10–12 mL 无水乙醇，分别记录转移前后质量。", "parameters": [{"name": "环己烷体积", "value": "5–6", "unit": "mL", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}, {"name": "乙醇体积", "value": "10–12", "unit": "mL", "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]}], "expected_observations": ["混合后形成澄清均一液相"], "hazards": ["易燃、挥发性液体"], "stop_conditions": ["出现泄漏、明显损失或称量记录缺失"], "content_status": "source_verified", "evidence_refs": ["user_legacy_guide"]},
