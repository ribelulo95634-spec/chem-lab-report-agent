    {"step_id": "preflight_01", "stage": "preflight", "action": "核对讲义正文实验名称、平衡釜设定温度、折射率标准曲线、废液桶类别及原版 K/β 公式。", "parameters": [], "expected_observations": [], "hazards": [], "stop_conditions": ["温度或标准曲线未明确", "原版公式无法核对且课程要求必须计算"], "content_status": "needs_review", "evidence_refs": ["user_legacy_guide"]},
